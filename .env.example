# PostgreSQL connection string (Neon / Vercel Postgres / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zemabet?sslmode=require"

# Bot token from @BotFather — used to verify Telegram Mini App login (HMAC secret)
TELEGRAM_BOT_TOKEN="1234567890:AAExampleTokenFromBotFather"

# Set to "production" on Vercel
NODE_ENV="development"

# Fast Keno: secret for provably-fair round seeds (use a long random string).
# If unset, the server refuses to start the round engine — make sure to set it.
FAST_KENO_SECRET=""

# Fast Keno: set to 0 to hide simulated lobby tickets in the "All" feed
FAST_KENO_SIM_PLAYERS="1"

# Spribe Aviator (external iframe demo): full launch URL, e.g.
# https://launch.spribegaming.com/games/launch/aviator?user=...&token=...&lang=en&currency=ETB&operator=...
# Use YOUR OWN Spribe session/API URL — leave empty to show a "not configured"
# placeholder page.
SPRIBE_AVIATOR_URL=""

# --- Admin deposit approval (agent panel + Telegram bot) ---
# Bot token for the ADMIN approval bot (different from TELEGRAM_BOT_TOKEN)
ADMIN_BOT_TOKEN="123456789:AAExampleAdminBotToken"

# Shared passcode protecting /api/admin/* and the /admin panel. Pick a long secret.
ADMIN_TOKEN="change-me-to-a-long-random-secret"

# Optional: restrict the admin bot to a single Telegram chat id (agent chat).
# Leave empty to allow any private chat that /start s the bot.
ADMIN_CHAT_ID=""

# Site root the admin bot uses to read/approve deposits (deployed URL in prod)
APP_URL="http://localhost:3000"

# How often the bot polls for new pending deposits (ms)
ADMIN_BOT_POLL_MS="15000"
