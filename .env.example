# PostgreSQL connection string (Neon / Vercel Postgres / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zemabet?sslmode=require"

# Bot token from @BotFather — used to verify Telegram Mini App login (HMAC secret)
TELEGRAM_BOT_TOKEN="1234567890:AAExampleTokenFromBotFather"

# Set to "production" on Vercel
NODE_ENV="development"

# Fast Keno: secret for provably-fair round seeds (use a long random string).
# If unset, a secret derived from DATABASE_URL is used.
FAST_KENO_SECRET=""

# Fast Keno: set to 0 to hide simulated lobby tickets in the "All" feed
FAST_KENO_SIM_PLAYERS="1"
